{
  "$schema": "https://opencode.ai/config.json",
  "keybinds": {
    "input_newline": "shift+enter,ctrl+enter"
  },
  "instructions": [
    "~/.claude/rules/chezmoi.md",
    "~/.claude/rules/git-workflow.md",
    "~/.claude/rules/java.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git ls-files*": "allow",
      "git remote -v": "allow",
      "git submodule status*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "find*": "allow",
      "tree*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      "diff*": "allow",
      "stat*": "allow",
      "du*": "allow",
      "file*": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "basename*": "allow",
      "dirname*": "allow",
      "realpath*": "allow",
      "echo*": "allow",
      "curl*": "allow",
      "which*": "allow",
      "date*": "allow",
      "hostname": "allow",
      "whoami": "allow",
      "type*": "allow",
      "set": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr status": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh issue status": "allow",
      "gh run view*": "allow",
      "gh run list*": "allow",
      "gh run watch*": "allow",
      "gh repo view*": "allow",
      "gh release view*": "allow",
      "gh release list*": "allow",
      "git push --force*": "deny",
      "git push --force-with-lease*": "deny",
      "git push -f*": "deny",
      "sops decrypt*": "deny"
    },
    "read": {
      "**": "allow",
      "../**": "ask",
      "./../**": "ask",
      ".env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/credentials*": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny"
    },
    "write": {
      "*": "ask",
      ".env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/credentials*": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny"
    },
    "edit": {
      "*": "ask",
      ".env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/credentials*": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny"
    }
  }
}
