[[ -f $HOME/.aliases ]] && source $HOME/.aliases
[[ -f $HOME/.exports ]] && source $HOME/.exports
[[ -f $HOME/.functions ]] && source $HOME/.functions

eval "$(mise activate zsh)"

# completions — cache generated scripts, regenerate only when binary changes
_cache_completion() {
  local cmd="$1"; shift
  local cache="$HOME/.zsh/completions/_${cmd}"
  local bin="$(command -v "$cmd" 2>/dev/null)"
  if [[ -z "$bin" ]]; then return; fi
  if [[ ! -f "$cache" || "$bin" -nt "$cache" ]]; then
    mkdir -p "$HOME/.zsh/completions"
    "$@" > "$cache" 2>/dev/null
  fi
}

fpath=($HOME/.zsh/completions $fpath)
_cache_completion gh     gh completion -s zsh
_cache_completion docker docker completion zsh
_cache_completion kubectl kubectl completion zsh
_cache_completion helm   helm completion zsh
_cache_completion helmfile helmfile completion zsh
_cache_completion mise   mise completion zsh

autoload -Uz compinit && compinit
eval "$(starship init zsh)"
eval "$(tv init zsh)"
eval "$(zoxide init zsh)"
