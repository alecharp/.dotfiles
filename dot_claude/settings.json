{
  "statusLine": {
    "type": "command",
    "command": "starship statusline claude-code"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v)",
      "Bash(git submodule status:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(file:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(echo:*)",
      "Bash(curl:*)",
      "Bash(which:*)",
      "Bash(date:*)",
      "Bash(hostname)",
      "Bash(whoami)",
      "Bash(type:*)",
      "Bash(set)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh repo view:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push -f*)",
      "Read(.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/credentials*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Write(.env)",
      "Write(**/.env.*)",
      "Write(**/*.pem)",
      "Write(**/credentials*)",
      "Write(**/id_rsa*)",
      "Write(**/id_ed25519*)",
      "Edit(.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/credentials*)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)"
    ]
  }
}
